@inject TuningArchiveSession Session

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">Reads the tuning, SimData, animation state machines and strings of the installed game, and the media they refer to. Nothing in the game's folder is changed.</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField T="string" Value="path" ValueChanged="OnPathChangedAsync" Label="The Sims 4 installation" Variant="Variant.Outlined" FullWidth="true" DebounceInterval="400" />
                @if (Session.Platform.CanPick)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="BrowseAsync">Browse…</MudButton>
                }
            </MudStack>
            @if (detected.Count > 1)
            {
                <MudChipSet T="string" SelectedValue="path" SelectedValueChanged="OnPathChangedAsync" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small">
                    @foreach (var candidate in detected)
                    {
                        <MudChip T="string" Value="candidate" Text="@candidate" />
                    }
                </MudChipSet>
            }
            @if (error is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@error</MudAlert>
            }
            @if (installation is not null)
            {
                <MudText Typo="Typo.caption">Found the base game and @(installation.Packs.Count - 1) packs: @string.Join(" ", installation.Packs.Skip(1).Select(pack => pack.Code))</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudTextField T="string" @bind-Value="gameVersion" Label="Game version" Variant="Variant.Outlined" Required="true" HelperText="@(installation.GameVersion is null ? "Couldn't be read from the installation" : "As the installation states it")" />
                    <MudTextField T="string" @bind-Value="label" Label="Label (optional)" Variant="Variant.Outlined" />
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudSelect T="string" @bind-Value="locale" Label="Strings" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem T="string" Value="@string.Empty">None</MudSelectItem>
                        @foreach (var available in installation.Locales.Order(StringComparer.Ordinal))
                        {
                            <MudSelectItem T="string" Value="available">@available</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="includeSimData" Label="Include SimData" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="includeAnimationStateMachines" Label="Include ASMs" Color="Color.Primary" />
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudSwitch T="bool" @bind-Value="includeImages" Label="Include images" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="includeSounds" Label="Include sounds" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="includeVideos" Label="Include videos" Color="Color.Primary" />
                </MudStack>
                <MudText Typo="Typo.caption">Media are kept so their history can be shown. Only what tuning and SimData refer to is kept, and only what changed adds to later snapshots, but the first capture is large: the base game and every pack came to about 1.3 GB of images, 2.9 GB of sounds (audio doesn't compress) and 0.5 GB of videos.</MudText>
                <MudTextField T="string" @bind-Value="notes" Label="Notes (optional)" Variant="Variant.Outlined" Lines="2" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="installation is null || string.IsNullOrWhiteSpace(gameVersion)" OnClick="Confirm">Capture</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string? path;
    IReadOnlyList<string> detected = [];
    GameInstallation? installation;
    string? error;
    string? gameVersion;
    string? label;
    string? notes;
    string locale = "ENG_US";
    bool includeAnimationStateMachines = true;
    bool includeImages = true;
    bool includeSounds;
    bool includeVideos;
    bool includeSimData = true;

    [CascadingParameter]
    IMudDialogInstance Dialog { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        detected = await Task.Run(GameInstallation.FindInstallations);
        if (Session.Platform.GetSetting("LastInstallation") is { } last && Directory.Exists(last))
            await OnPathChangedAsync(last);
        else if (detected.Count > 0)
            await OnPathChangedAsync(detected[0]);
    }

    async Task BrowseAsync()
    {
        if (await Session.Platform.PickFolderAsync("The Sims 4 installation") is { } picked)
            await OnPathChangedAsync(picked);
    }

    async Task OnPathChangedAsync(string? value)
    {
        path = value;
        installation = null;
        error = null;
        if (string.IsNullOrWhiteSpace(value))
            return;
        try
        {
            installation = await Task.Run(() => GameInstallation.Open(value.Trim().Trim('"')));
            gameVersion = installation.GameVersion;
            if (!installation.Locales.Contains(locale))
                locale = installation.Locales.Contains("ENG_US") ? "ENG_US" : installation.Locales.FirstOrDefault() ?? string.Empty;
        }
        catch (Exception ex) when (ex is DirectoryNotFoundException or IOException or UnauthorizedAccessException or ArgumentException)
        {
            error = ex.Message;
        }
    }

    void Confirm()
    {
        if (installation is null)
            return;
        Session.Platform.SetSetting("LastInstallation", path);
        Dialog.Close(DialogResult.Ok(new CaptureRequest(installation, new TuningArchiveCaptureOptions
        {
            GameVersion = gameVersion?.Trim(),
            IncludeAnimationStateMachines = includeAnimationStateMachines,
            IncludeImages = includeImages,
            IncludeSounds = includeSounds,
            IncludeVideos = includeVideos,
            IncludeSimData = includeSimData,
            Label = string.IsNullOrWhiteSpace(label) ? null : label.Trim(),
            Locale = string.IsNullOrEmpty(locale) ? null : locale,
            Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim()
        })));
    }
}