<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Common\LibraryProject.props" />

    <PropertyGroup>
        <Product>LlamaLogic.TuningDescriptions</Product>
        <Version>1.0.0</Version>
        <Description>Read the tuning descriptions (TDESCs) Maxis publishes for The Sims 4, and generate SimData from tuning with them.</Description>
        <PackageIcon>NuGet.png</PackageIcon>
        <TargetFrameworks>net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SharpCompress" Version="0.50.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LlamaLogic.Packages\LlamaLogic.Packages.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="NuGet.png" Pack="True" PackagePath="" />
    </ItemGroup>

</Project>
